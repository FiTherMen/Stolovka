# Скопіюйте у файл .env в корені репозиторію на сервері: cp deploy/env.example .env
# Файл .env містить секрети: не комітьте його і не надсилайте в чат.

# Домен сайту (A-запис має вказувати на IP сервера), напр. stolovka.example.com
APP_DOMAIN=

# Supabase: Project URL і ключі (Project Settings → API).
# Варіант А: https://xxxx.supabase.co ; варіант Б: https://<SUPABASE_DOMAIN>
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Лише для варіанту Б: домен для власного Supabase, напр. db.stolovka.example.com
SUPABASE_DOMAIN=

# Telegram
TELEGRAM_BOT_USERNAME=online_stolovka_bot
TELEGRAM_BOT_TOKEN=
# Будь-який довгий випадковий рядок: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Числовий Telegram ID власника (через кому, якщо кілька адмінів)
ADMIN_TELEGRAM_IDS=

# Вечірнє зведення кухарям «Що готувати на завтра» (HH:MM за Мадридом або off)
PREP_SUMMARY_TIME=21:05
